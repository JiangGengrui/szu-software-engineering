.editor-page{padding:28rpx 28rpx 40rpx}
.editor-head{font-family:"Songti SC","STSong","Noto Serif CJK SC","Source Han Serif SC","SimSun",serif;font-size:44rpx;letter-spacing:.1em;line-height:1.3}
.editor-sub{font-size:19rpx;color:#a99c86;letter-spacing:.34em;margin:8rpx 0 24rpx}
.upload-status{display:flex;align-items:center;gap:12rpx;padding:16rpx 20rpx;background:rgba(194,112,58,.08);border:1rpx dashed rgba(194,112,58,.45);border-radius:4rpx;color:#8a5a2b;font-size:23rpx;margin-bottom:20rpx;letter-spacing:.06em}
.upload-dot{width:12rpx;height:12rpx;border-radius:50%;background:#c2703a;flex:none}
.thumbs{display:flex;flex-wrap:wrap;margin:0 -6rpx}
.thumb{width:33.333%;padding:6rpx;box-sizing:border-box}
.thumb-wide{width:100%}
.thumb-box{position:relative;width:100%;height:0;padding-bottom:100%;background:#fffdf7;border:1rpx solid #e6d9bf;overflow:hidden}
.thumb-video-box{height:320rpx;padding-bottom:0}
.thumb-img{position:absolute;left:0;top:0;width:100%;height:100%}
.preview-video{position:absolute;left:0;top:0;width:100%;height:100%;background:#2b2622}
.thumb-no{position:absolute;left:0;bottom:0;background:rgba(20,16,12,.55);color:#fbf6e9;font-size:18rpx;padding:3rpx 10rpx;letter-spacing:.06em}
.thumb-add{height:223rpx;padding-bottom:0;border-style:dashed;background:rgba(255,253,247,.55);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx}
.thumb-plus{font-size:40rpx;color:#b7a98f;font-weight:300;line-height:1}
.thumb-add-label{font-size:20rpx;color:#9a8e78;letter-spacing:.1em}
.titled{background:#fffdf7;border:1rpx solid #e6d9bf;border-radius:6rpx;padding:22rpx 22rpx 18rpx}
.paper-input{background:#fffcf2;border:1rpx solid #e8dcc2;min-height:280rpx}
.date-field{display:flex;align-items:center;justify-content:space-between;background:#fffcf2;border:1rpx solid #e8dcc2;border-radius:6rpx;padding:20rpx;font-size:28rpx}
.date-caret{font-size:22rpx;color:#8a5a2b;letter-spacing:.1em}
.tags-row{gap:8rpx}
.submit{margin-top:8rpx}
.editor-note{text-align:center;margin-top:12rpx}
.result-row{padding:16rpx 0;border-bottom:1rpx dashed #e0d3b8;font-size:24rpx;color:#8a5a2b;word-break:break-all}
