.auth-page{padding:0 40rpx 60rpx}
.seal{width:112rpx;height:112rpx;margin:56rpx auto 0;border:2rpx solid rgba(194,112,58,.6);border-radius:8rpx;display:flex;align-items:center;justify-content:center;color:#c2703a;font-size:52rpx;background:rgba(194,112,58,.05);transform:rotate(-3deg);box-shadow:0 2rpx 0 rgba(255,255,255,.7) inset}
.brand{text-align:center;margin:32rpx 0 40rpx}
.brand .title{font-size:60rpx;letter-spacing:.32em;text-indent:.32em;display:block;line-height:1.3}
.slogan{margin-top:18rpx;font-size:23rpx;color:#6b6259;letter-spacing:.14em;line-height:1.9}
.auth-card{background:#fffdf7;border:1rpx solid #e6d9bf;border-radius:6rpx;padding:32rpx 30rpx 30rpx;box-shadow:0 24rpx 48rpx -40rpx rgba(90,60,20,.8)}
.modes{border-bottom:1rpx solid #d9cbb0;margin-bottom:34rpx}
.mode{background:transparent;border:0;border-radius:0;padding:0 0 16rpx;font-size:27rpx;letter-spacing:.24em;color:#9a8e78;min-height:44px}
.mode.on{color:#2b2622;font-weight:600;position:relative}
.mode.on::after{content:"";position:absolute;left:50%;bottom:-1rpx;transform:translateX(-50%);width:56rpx;height:3rpx;background:#c2703a}
.auth-page input{background:transparent;border:0;border-bottom:1rpx solid #d8c9ac;border-radius:0;padding:14rpx 0;font-size:28rpx;min-height:44px}
.auth-page .label{font-size:20rpx;letter-spacing:.3em;margin-bottom:4rpx}
.error-box{border-radius:4rpx;font-size:24rpx;line-height:1.7}
.submit{margin-top:14rpx}
.auth-hint{margin-top:20rpx;font-size:21rpx;color:#a99c86;text-align:center;letter-spacing:.04em;line-height:1.8}
.guest{margin:36rpx auto 0;display:block;font-size:23rpx;color:#6b6259;letter-spacing:.14em;border-bottom:1rpx dashed #c9ba9e;padding:6rpx 4rpx;background:transparent}
