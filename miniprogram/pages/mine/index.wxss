.mine-page{padding:0 24rpx calc(170rpx + env(safe-area-inset-bottom))}
.mine-head{padding:20rpx 4rpx 0}
.mine-title{font-size:46rpx;letter-spacing:.1em;line-height:1.3}
.mine-sub{margin-top:10rpx;font-size:23rpx;color:#6b6259;letter-spacing:.04em;word-break:break-all}
.mine-stats{margin-top:14rpx;font-size:22rpx;color:#8c8272;letter-spacing:.08em}
.mine-stats .num{font-size:30rpx;color:#8a5a2b}
.settings-link{font-size:23rpx;color:#8a5a2b;padding:8rpx 0}
.mine-page .panel{margin:20rpx 0}
.mine-page .error-box{margin:20rpx 0}
.month-row{display:flex;align-items:center;gap:14rpx;padding:26rpx 4rpx 14rpx}
.month-label{font-size:26rpx;letter-spacing:.1em;color:#5a5145}
.month-count{font-size:20rpx;color:#a99c86}
.wall{display:flex;flex-wrap:wrap;margin:0 -6rpx}
.tile{width:50%;padding:0 6rpx 22rpx}
.tile-cover{position:relative;width:100%;height:0;padding-bottom:100%;overflow:hidden;border:1rpx solid #e6d9bf;background:#efe6d2}
.tile-img{position:absolute;left:0;top:0;width:100%;height:100%}
.tile-stamp{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-7deg);border:2rpx solid rgba(180,71,46,.75);color:#b4472e;background:rgba(255,250,240,.8);font-size:22rpx;letter-spacing:.2em;padding:4rpx 12rpx;border-radius:3rpx}
.tile-retry{position:absolute;left:0;right:0;bottom:0;background:rgba(20,16,12,.5);color:#fbf6e9;text-align:center;font-size:20rpx;padding:6rpx 0}
.tile-title{margin-top:12rpx;font-size:27rpx;line-height:1.45;word-break:break-all;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tile-meta{margin-top:4rpx;font-size:20rpx;color:#8c8272}
.tile-actions{display:flex;gap:16rpx;margin-top:8rpx;align-items:center}
.tile-btn{font-size:22rpx;color:#8a5a2b;letter-spacing:.04em;padding:2rpx 0}
.tile-btn.danger{color:#b4472e}
