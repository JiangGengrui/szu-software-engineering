<view class="page tab-page mine-page">
  <view class="mine-head">
    <view class="row between">
      <view class="grow">
        <view class="mine-title serif">我的作品</view>
        <view class="mine-sub">{{username || '登录后管理自己的校园记录'}}</view>
      </view>
      <button wx:if="{{ready}}" class="link settings-link" bindtap="settings">账号设置</button>
    </view>
    <view wx:if="{{ready}}" class="mine-stats">共 <text class="num serif">{{total}}</text> 份记录（含已移除）</view>
  </view>
  <view class="rule-thick"></view>
  <view class="rule-thin"></view>

  <view wx:if="{{checking}}" class="panel state loading">正在确认登录状态…</view>
  <view wx:elif="{{!ready}}" class="panel state"><view class="state-title">请先登录</view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" bindtap="login">去登录</button><button class="link" bindtap="refresh">重试身份确认</button></view>

  <block wx:else>
    <view wx:if="{{actionError}}" class="error-box"><text>{{actionError}}</text><button class="link" bindtap="refresh">刷新查询当前状态</button></view>

    <view wx:if="{{!loading && !error && !list.length}}" class="panel state"><view class="state-title">你还没有发布作品</view><text class="muted">记录一次活动，或分享一个校园瞬间</text><button class="primary" bindtap="publish">去发布</button></view>

    <block wx:for="{{groups}}" wx:key="label" wx:for-item="group">
      <view class="month-row"><text class="month-label serif">{{group.label}}</text><view class="hair grow"/><text class="month-count">{{group.items.length}} 张</text></view>
      <view class="wall">
        <view wx:for="{{group.items}}" wx:key="id" class="tile">
          <view class="tile-cover" data-id="{{item.id}}" bindtap="open">
            <image wx:if="{{item.status === 'visible' && item.cover && !mediaFailures[item.id]}}" class="tile-img" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"/>
            <view wx:else class="cover-placeholder {{item.status === 'removed' ? 'status-removed' : ''}}"><text>{{item.status === 'removed' ? '媒体不可用' : mediaFailures[item.id] ? '封面加载失败' : item.media_kind === 'video' ? '▷ 视频' : '文字作品'}}</text></view>
            <view wx:if="{{item.status === 'removed'}}" class="tile-stamp">{{item.stateText}}</view>
            <view wx:if="{{item.status === 'visible' && mediaFailures[item.id]}}" class="tile-retry" data-id="{{item.id}}" catchtap="retryImage">重试</view>
          </view>
          <view class="tile-title serif">{{item.label}}</view>
          <view class="tile-meta">{{item.activity_date}}</view>
          <view class="tile-actions">
            <view class="tile-btn" data-id="{{item.id}}" bindtap="open">{{item.status === 'visible' ? '查看' : '状态'}}</view>
            <view wx:if="{{item.status === 'visible'}}" class="tile-btn" data-id="{{item.id}}" bindtap="edit">编辑</view>
            <view wx:if="{{item.status === 'visible'}}" class="tile-btn danger" data-id="{{item.id}}" bindtap="remove">{{deleting === item.id ? '删除中…' : '删除'}}</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button bindtap="loadMore">重试加载</button></view>
    <view wx:elif="{{loading}}" class="footer">正在加载作品…</view>
    <view wx:elif="{{done && list.length}}" class="footer">已显示全部 {{total}} 条作品（含已移除）</view>
  </block>
</view>
