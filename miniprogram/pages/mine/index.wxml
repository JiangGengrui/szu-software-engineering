<view class="page tab-page"><view class="row between heading"><view><view class="title">我的作品</view><text class="muted">{{username || '登录后管理自己的校园记录'}}</text></view><button wx:if="{{ready}}" class="link" bindtap="settings">账号设置</button></view><view wx:if="{{checking}}" class="panel state loading">正在确认登录状态…</view><view wx:elif="{{!ready}}" class="panel state"><view class="state-title">请先登录</view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" bindtap="login">去登录</button><button class="link" bindtap="refresh">重试身份确认</button></view><block wx:else><view wx:if="{{actionError}}" class="error-box"><text>{{actionError}}</text><button class="link" bindtap="refresh">刷新查询当前状态</button></view><view wx:if="{{!loading && !error && !list.length}}" class="panel state"><view class="state-title">你还没有发布作品</view><text class="muted">记录一次活动，或分享一个校园瞬间</text><button class="primary" bindtap="publish">去发布</button></view><view wx:for="{{list}}" wx:key="id" class="panel"><view class="cover" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.status === 'visible' && item.cover && !mediaFailures[item.id]}}" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"/><view wx:else class="cover-placeholder {{item.status === 'removed' ? 'status-removed' : ''}}"><text>{{item.status === 'removed' ? '作品已移除 · 媒体不可用' : mediaFailures[item.id] ? '封面加载失败' : item.media_kind === 'video' ? '▷ 视频作品' : '文字作品'}}</text><button wx:if="{{item.status === 'visible' && mediaFailures[item.id]}}" class="link" data-id="{{item.id}}" catchtap="retryImage">重试封面</button></view></view><view class="card-title"><text>{{item.label}}</text></view><view class="row between"><text class="card-meta">活动日期 {{item.activity_date}}</text><text class="chip {{item.status === 'removed' ? 'status-removed' : ''}}">{{item.stateText}}</text></view><view class="row card-action"><button class="grow" data-id="{{item.id}}" bindtap="open">{{item.status === 'visible' ? '查看详情' : '查看状态'}}</button><block wx:if="{{item.status === 'visible'}}"><button data-id="{{item.id}}" disabled="{{deleting > 0}}" bindtap="edit">编辑</button><button class="danger" data-id="{{item.id}}" disabled="{{deleting > 0}}" loading="{{deleting === item.id}}" bindtap="remove">删除</button></block></view></view><view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button bindtap="loadMore">重试加载</button></view><view wx:elif="{{loading}}" class="footer">正在加载作品…</view><view wx:elif="{{done && list.length}}" class="footer">已显示全部 {{total}} 条作品（含已移除）</view></block></view>
