<view class="page"><view wx:if="{{unavailable}}" class="panel state"><view class="state-title">{{unavailable}}</view><text class="muted">该作品的内容、媒体和互动已不可访问</text><button bindtap="home">返回首页</button></view><view wx:elif="{{loading}}" class="panel"><view class="skeleton skeleton-line"/><view class="skeleton skeleton-line skeleton-short"/><view class="cover skeleton spaced"/><view class="loading spaced">正在加载作品…</view></view><view wx:elif="{{error}}" class="panel state"><view class="error">{{error}}</view><button bindtap="reload">重试加载</button><button class="link" bindtap="home">返回首页</button></view><block wx:elif="{{work}}"><view class="panel"><view wx:if="{{work.title}}" class="title">{{work.title}}</view><view class="muted spaced"><text>{{work.user.username}} · 活动日期 {{work.activity_date}}</text></view><view class="row wrap spaced"><text wx:for="{{work.tags}}" wx:key="*this" class="chip">{{item}}</text></view><text wx:if="{{work.content}}" class="body-text content">{{work.content}}</text><view class="media-list"><block wx:for="{{work.media}}" wx:key="id"><image wx:if="{{item.kind === 'image'}}" class="detail-image" src="{{item.url}}" mode="widthFix" data-value="{{item.url}}" data-index="{{index}}" bindtap="preview" binderror="mediaFailed"/><video wx:else src="{{item.url}}" class="detail-video" style="height:{{videoHeight}}px" controls object-fit="contain" data-index="{{index}}" show-center-play-btn bindloadedmetadata="videoMetadata" binderror="mediaFailed"/></block></view><view wx:if="{{mediaError}}" class="error-box"><text>{{mediaError}}</text><button bindtap="reload">重新获取媒体</button></view></view><view class="panel"><view class="row between"><text class="section-title">作品评分</text><text class="rating-summary">{{ratingText}}</text></view><view wx:if="{{own}}" class="hint">不能给自己的作品评分，仍可发表评论</view><view wx:else><view class="muted">{{myScore ? '我的评分：' + myScore + '分；再次提交会更新原评分，不增加人数' : '选择1—5分，表达你的评价'}}</view><view class="row scores"><button wx:for="{{stars}}" wx:key="*this" class="grow {{score === item ? 'primary' : ''}}" data-score="{{item}}" disabled="{{ratingBusy}}" bindtap="selectScore">{{item}}</button></view><button class="primary" loading="{{ratingBusy}}" disabled="{{ratingBusy}}" bindtap="sendRating">{{!loggedIn ? '登录后评分' : ratingBusy ? '正在提交…' : myScore ? '更新评分' : '提交评分'}}</button></view><view wx:if="{{ratingError}}" class="error-box"><text>{{ratingError}}</text><button class="link" bindtap="reload">刷新状态</button></view></view><view class="panel"><view class="section-title">评论</view><view wx:for="{{comments}}" wx:key="id" class="comment"><view class="comment-name">{{item.display_name}}</view><text class="body-text">{{item.content}}</text><view class="hint">{{item.time}}</view></view><view wx:if="{{commentsLoading}}" class="loading">正在加载评论…</view><view wx:elif="{{commentsError}}" class="error-box"><text>{{commentsError}}</text><button bindtap="loadComments">重试加载评论</button></view><view wx:elif="{{!comments.length}}" class="muted">暂无评论</view><button wx:if="{{!commentsLoading && !commentsDone && !commentsError}}" class="link" bindtap="loadComments">加载更多评论</button><view class="field spaced"><text class="label">发表评论</text><textarea value="{{comment}}" maxlength="-1" disabled="{{commentBusy}}" bindinput="inputComment" placeholder="说说你的感受（1—500字）"/><view class="count">{{commentCount}} / 500</view></view><view wx:if="{{commentError}}" class="error-box"><text>{{commentError}}</text><button class="link" bindtap="reload">查询最新状态</button></view><button class="primary" loading="{{commentBusy}}" disabled="{{commentBusy}}" bindtap="sendComment">{{commentBusy ? '正在发送…' : loggedIn ? '发送评论' : '登录后评论'}}</button></view></block></view>
