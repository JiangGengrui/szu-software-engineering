<view class="page tab-page home">
  <view class="masthead">
    <view class="kicker serif">CAMPUS ALBUM</view>
    <view class="row between masthead-row">
      <view class="grow">
        <view class="wordmark serif">校园影集</view>
        <view class="masthead-sub">{{date ? date + ' · ' : ''}}共 {{total}} 份校园记录</view>
      </view>
      <button wx:if="{{!username}}" class="link masthead-login" bindtap="login">登录</button>
      <text wx:else class="user-name">{{username}}</text>
    </view>
  </view>
  <view class="rule-thick"></view>
  <view class="rule-thin"></view>

  <view class="pills">
    <picker mode="date" value="{{date}}" bindchange="chooseDate"><view class="pill {{date ? 'on' : ''}}">{{date || '全部日期'}}<text class="caret"/></view></picker>
    <view class="pill {{selectedTags.length ? 'on' : ''}}" bindtap="toggleTags">标签{{selectedTags.length ? ' · ' + selectedTags.length : ''}}<text class="caret"/></view>
    <view class="pill ghost" bindtap="toggleView">{{view === 'reel' ? '列表' : '翻页'}}</view>
  </view>

  <scroll-view wx:if="{{date || selectedTags.length}}" scroll-x class="chips"><view class="row chips-row"><view wx:if="{{date}}" class="chip-button" bindtap="clearDate">{{date}} ×</view><view wx:for="{{selectedTags}}" wx:key="*this" class="chip-button" data-value="{{item}}" bindtap="removeTag">{{item}} ×</view><view class="chips-clear" bindtap="clearFilters">清空筛选</view></view></scroll-view>

  <view wx:if="{{showTags}}" class="panel tag-picker">
    <view class="muted">多选标签 · 作品须同时包含所有所选标签</view>
    <view wx:if="{{tagLoading}}" class="loading">正在加载标签…</view>
    <view wx:elif="{{tagError}}" class="error-box"><text>{{tagError}}</text><button bindtap="loadTags">重试标签</button></view>
    <view wx:elif="{{!tags.length}}" class="muted">暂无可选标签</view>
    <checkbox-group wx:else bindchange="changeTags"><label wx:for="{{tags}}" wx:key="id" class="tag-option"><checkbox value="{{item.name}}" checked="{{item.checked}}" color="#C2703A"/><text>{{item.name}}</text></label></checkbox-group>
    <button class="link" bindtap="toggleTags">收起标签</button>
  </view>

  <block wx:if="{{loading && !list.length}}"><view class="frame reel-skeleton"><view class="skeleton reel-shot"/><view class="skeleton skeleton-line"/><view class="skeleton skeleton-line skeleton-short"/></view></block>
  <view wx:elif="{{!list.length && !error}}" class="panel state"><view class="state-title">{{date ? '该日期暂无作品' : selectedTags.length ? '暂无匹配作品' : '这本相册还没有照片'}}</view><text class="muted">{{date || selectedTags.length ? '试试清空筛选，看看其他校园记录' : '第一份校园记录，等你来发布'}}</text><button wx:if="{{date || selectedTags.length}}" bindtap="clearFilters">清空筛选</button></view>

  <block wx:elif="{{view === 'reel'}}">
    <swiper class="reel" current="{{current}}" bindchange="swipe" duration="260">
      <swiper-item wx:for="{{list}}" wx:key="id">
        <view class="slide" data-id="{{item.id}}" bindtap="open">
          <view class="frame">
            <view class="frame-shot">
              <image wx:if="{{item.cover && !mediaFailures[item.id]}}" class="frame-img" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="imageError"/>
              <view wx:else class="cover-placeholder"><text>{{mediaFailures[item.id] ? '封面加载失败' : item.media_kind === 'video' ? '▷ 视频作品' : '文字作品'}}</text><button wx:if="{{mediaFailures[item.id]}}" class="link" data-id="{{item.id}}" catchtap="retryImage">重试封面</button></view>
              <view class="frame-badge">{{item.media_kind === 'video' ? '▷ 视频' : '相片'}}</view>
            </view>
            <view class="frame-cap">
              <view class="frame-title serif">{{item.label}}</view>
              <view class="frame-meta">{{item.user.username}} · 活动日期 {{item.activity_date}}</view>
              <view class="row between frame-foot"><text class="rating">{{item.ratingText}}</text><text class="frame-more">翻到详情 ›</text></view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="reel-foot">
      <text class="reel-hint">左右滑动翻页</text>
      <text class="reel-page serif">{{current + 1}} / {{list.length}}</text>
    </view>
  </block>

  <block wx:else><view wx:for="{{list}}" wx:key="id" class="panel work-card"><view data-id="{{item.id}}" bindtap="open"><view class="cover"><image wx:if="{{item.cover && !mediaFailures[item.id]}}" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="imageError"/><view wx:else class="cover-placeholder"><text>{{mediaFailures[item.id] ? '封面加载失败' : item.media_kind === 'video' ? '▷ 视频作品' : '文字作品'}}</text><button wx:if="{{mediaFailures[item.id]}}" class="link" data-id="{{item.id}}" catchtap="retryImage">重试封面</button></view></view><view class="card-title"><text>{{item.label}}</text></view><view class="card-meta"><text>{{item.user.username}} · 活动日期 {{item.activity_date}}</text></view><view class="row between spaced"><text class="rating">{{item.ratingText}}</text><text class="muted">查看详情 ›</text></view></view></view></block>

  <view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button class="spaced" bindtap="retry">重试加载</button></view><view wx:elif="{{loading && list.length}}" class="footer">正在加载更多…</view><view wx:elif="{{done && list.length}}" class="footer">已显示全部 {{total}} 条作品</view>
</view>
