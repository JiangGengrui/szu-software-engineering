<view class="page tab-page">
  <view class="row between heading"><view><view class="title">校园最新动态</view><text class="muted">记录校园，让每次相遇被看见</text></view><button wx:if="{{!username}}" class="link" bindtap="login">登录</button><text wx:else class="user-name muted">{{username}}</text></view>
  <view class="panel filters"><view class="row"><picker class="grow" mode="date" value="{{date}}" bindchange="chooseDate"><button>日期 · {{date || '全部日期'}}</button></picker><button bindtap="toggleTags">标签{{selectedTags.length ? ' · ' + selectedTags.length : ''}}</button></view>
    <scroll-view wx:if="{{date || selectedTags.length}}" scroll-x class="chips"><view class="row"><button wx:if="{{date}}" class="chip-button" bindtap="clearDate">{{date}} ×</button><button wx:for="{{selectedTags}}" wx:key="*this" class="chip-button" data-value="{{item}}" bindtap="removeTag">{{item}} ×</button><button class="link" bindtap="clearFilters">清空筛选</button></view></scroll-view>
    <view wx:if="{{showTags}}" class="tag-picker"><view class="muted">多选标签 · 作品须同时包含所有所选标签</view><view wx:if="{{tagLoading}}" class="loading">正在加载标签…</view><view wx:elif="{{tagError}}" class="error-box"><text>{{tagError}}</text><button bindtap="loadTags">重试标签</button></view><view wx:elif="{{!tags.length}}" class="muted">暂无可选标签</view><checkbox-group wx:else bindchange="changeTags"><label wx:for="{{tags}}" wx:key="id" class="tag-option"><checkbox value="{{item.name}}" checked="{{item.checked}}" color="#2F5597"/><text>{{item.name}}</text></label></checkbox-group><button class="link" bindtap="toggleTags">收起标签</button></view>
  </view>
  <block wx:if="{{loading && !list.length}}"><view wx:for="{{skeletons}}" wx:key="*this" class="panel"><view class="cover skeleton"/><view class="skeleton skeleton-line"/><view class="skeleton skeleton-line skeleton-short"/></view></block>
  <view wx:elif="{{!list.length && !error}}" class="panel state"><view class="state-title">{{date ? '该日期暂无作品' : selectedTags.length ? '暂无匹配作品' : '暂无作品'}}</view><text class="muted">{{date || selectedTags.length ? '试试清空筛选，看看其他校园记录' : '第一份校园记录，等你来发布'}}</text><button wx:if="{{date || selectedTags.length}}" bindtap="clearFilters">清空筛选</button></view>
  <view wx:for="{{list}}" wx:key="id" class="panel work-card"><view data-id="{{item.id}}" bindtap="open"><view class="cover"><image wx:if="{{item.cover && !mediaFailures[item.id]}}" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="imageError"/><view wx:else class="cover-placeholder"><text>{{mediaFailures[item.id] ? '封面加载失败' : item.media_kind === 'video' ? '▷ 视频作品' : '文字作品'}}</text><button wx:if="{{mediaFailures[item.id]}}" class="link" data-id="{{item.id}}" catchtap="retryImage">重试封面</button></view></view><view class="card-title"><text>{{item.label}}</text></view><view class="card-meta"><text>{{item.user.username}} · 活动日期 {{item.activity_date}}</text></view><view class="row between spaced"><text class="rating">{{item.ratingText}}</text><text class="muted">查看详情 ›</text></view></view></view>
  <view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button class="spaced" bindtap="loadMore">重试加载</button></view><view wx:elif="{{loading && list.length}}" class="footer">正在加载更多…</view><view wx:elif="{{done && list.length}}" class="footer">已显示全部 {{total}} 条作品</view>
</view>
