.settings-page{padding:24rpx 24rpx 60rpx}
.page-head{font-size:40rpx;letter-spacing:.22em;margin:8rpx 4rpx 24rpx}
.settings-page .panel{margin:0 0 24rpx}
.group{background:#fffdf7;border:1rpx solid #e6d9bf;border-radius:6rpx;margin-bottom:24rpx;overflow:hidden;box-shadow:0 20rpx 40rpx -38rpx rgba(90,60,20,.8)}
.group-head{padding:18rpx 26rpx 14rpx;font-size:20rpx;letter-spacing:.32em;color:#9a8e78;background:rgba(230,217,191,.22);border-bottom:1rpx dashed #d9cbb0}
.group-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 26rpx;font-size:26rpx}
.group-row + .group-row{border-top:1rpx dashed #e0d3b8}
.row-k{color:#6b6259;font-size:23rpx;letter-spacing:.1em}
.row-v{color:#2b2622;font-size:26rpx;letter-spacing:.04em;word-break:break-all;text-align:right}
.row-v.accent{color:#8a5a2b}
.group-body{padding:24rpx 26rpx 26rpx}
.group-body .field:last-of-type{margin-bottom:18rpx}
.group-body .hint{margin-top:14rpx}
.danger.full{margin-top:18rpx}
