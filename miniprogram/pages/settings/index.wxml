<view class="page settings-page">
  <view class="page-head serif">账号设置</view>

  <view wx:if="{{loading}}" class="panel state loading">正在确认登录状态…</view>
  <view wx:elif="{{!ready}}" class="panel state"><view class="state-title">请重新登录</view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" bindtap="login">去登录</button><button class="link" bindtap="home">游客浏览首页</button><button class="link" bindtap="enter">重试身份确认</button></view>

  <block wx:else>
    <view class="group">
      <view class="group-head">账号</view>
      <view class="group-row"><text class="row-k">用户名</text><text class="row-v serif">{{username}}</text></view>
      <view class="group-row"><text class="row-k">登录状态</text><text class="row-v accent">已登录</text></view>
    </view>

    <view class="group">
      <view class="group-head">修改密码</view>
      <view class="group-body">
        <view class="field"><text class="label">原密码</text><input value="{{old_password}}" password maxlength="-1" disabled="{{busy}}" data-field="old_password" bindinput="input" placeholder="请输入当前密码"/><text wx:if="{{field === 'old_password'}}" class="field-error">{{error}}</text></view>
        <view class="field"><text class="label">新密码</text><input value="{{new_password}}" password maxlength="-1" disabled="{{busy}}" data-field="new_password" bindinput="input" placeholder="8—20位，包含字母和数字"/><text wx:if="{{field === 'new_password'}}" class="field-error">{{error}}</text></view>
        <view class="field"><text class="label">确认新密码</text><input value="{{confirmation}}" password maxlength="-1" disabled="{{busy}}" data-field="confirmation" bindinput="input" placeholder="请再次输入新密码"/><text wx:if="{{field === 'confirmation'}}" class="field-error">{{error}}</text></view>
        <view wx:if="{{error}}" class="error-box">{{error}}</view>
        <button class="primary full" loading="{{busy}}" disabled="{{busy}}" bindtap="changePassword">{{busy ? '处理中…' : '保存新密码'}}</button>
        <view class="hint">修改成功后，所有旧版小程序登录凭据失效，需要重新登录。</view>
      </view>
    </view>

    <view class="group">
      <view class="group-head">结束登录</view>
      <view class="group-body">
        <view class="hint">退出后仍可游客浏览。成功退出将撤销该账号旧版小程序登录凭据。</view>
        <button class="danger full spaced" loading="{{busy}}" disabled="{{busy}}" bindtap="logout">退出登录</button>
      </view>
    </view>
  </block>
</view>
