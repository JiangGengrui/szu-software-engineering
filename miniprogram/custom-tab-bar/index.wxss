.tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1px solid #e4e9f1;padding-bottom:env(safe-area-inset-bottom);z-index:50}.tab{width:33.333%;min-height:54px;background:#fff;border-radius:0;line-height:1.25;font-size:24rpx;color:#64748b;padding:12rpx 0}.tab::after{border:0}.tab text{display:block}.symbol{font-size:40rpx;line-height:42rpx;height:42rpx}.active{color:#2f5597;font-weight:650;background:#f3f6fc}
