.tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;background:#fffdf7;border-top:1rpx dashed #d9cbb0;padding-bottom:env(safe-area-inset-bottom);z-index:50;box-shadow:0 -12rpx 28rpx -22rpx rgba(90,60,20,.55)}
.tab{width:33.333%;min-height:54px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;padding:12rpx 0;font-size:22rpx;letter-spacing:.1em;color:#8c8272;background:transparent}
.tab-icon{width:44rpx;height:44rpx;background-repeat:no-repeat;background-position:center;background-size:44rpx 44rpx;opacity:.9}
.tab.active{color:#c2703a}
.tab.active .tab-icon{opacity:1}
.tab.active .tab-label{font-weight:600}
.tab-icon--home{background-image:url("data:image/svg+xml;base64,")}
.tab-icon--publish{background-image:url("data:image/svg+xml;base64,")}
.tab-icon--mine{background-image:url("data:image/svg+xml;base64,")}
.tab.active .tab-icon--home{background-image:url("data:image/svg+xml;base64,")}
.tab.active .tab-icon--publish{background-image:url("data:image/svg+xml;base64,")}
.tab.active .tab-icon--mine{background-image:url("data:image/svg+xml;base64,")}
