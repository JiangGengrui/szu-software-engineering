page{background:#f4f6fa;color:#1e293b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.6}view,text,button,input,textarea{box-sizing:border-box}button{min-height:44px;line-height:1.4;padding:22rpx 28rpx;border-radius:16rpx;font-size:28rpx;background:#fff;color:#2f5597;margin:0}button::after{border:1px solid #cbd5e1;border-radius:16rpx}button[disabled]{background:#e8edf4;color:#637184}button.primary{background:#2f5597;color:#fff}button.primary::after{border:0}button.danger{color:#b42318}button.link{background:transparent;padding:16rpx}button.link::after{border:0}.page{padding:32rpx;max-width:960rpx;margin:0 auto}.tab-page{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}.panel{background:#fff;border:1px solid #e4e9f1;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.muted{color:#64748b;font-size:26rpx}.title{font-size:38rpx;font-weight:650;line-height:1.35;word-break:break-all}.subtitle{font-size:32rpx;font-weight:600}.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.field{margin-bottom:28rpx}.label{display:block;font-weight:550;margin-bottom:12rpx}input,textarea{background:#f7f9fc;border:1px solid #ccd5e3;border-radius:14rpx;min-height:44px;padding:20rpx;width:100%;font-size:30rpx}textarea{height:280rpx;line-height:1.6}.field-error,.error{color:#a62118;font-size:27rpx;word-break:break-all}.error-box{background:#fff1ef;border:1px solid #ffd2cc;border-radius:16rpx;padding:24rpx;margin:20rpx 0}.hint{color:#64748b;font-size:25rpx;margin-top:10rpx}.state{padding:64rpx 24rpx;text-align:center}.state button{margin:24rpx auto 0;max-width:360rpx}.state-title{font-size:34rpx;font-weight:600;margin-bottom:12rpx}.chip{display:inline-flex;align-items:center;background:#eaf0fa;color:#2f5597;border-radius:24rpx;padding:8rpx 20rpx;font-size:25rpx}.chip-button{border-radius:28rpx;white-space:nowrap;flex-shrink:0}.cover{width:100%;height:0;padding-bottom:56.25%;position:relative;overflow:hidden;border-radius:16rpx;background:#eaf0f8}.cover image{position:absolute;width:100%;height:100%}.cover-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#526784;font-size:30rpx}.cover-placeholder text{display:block}.card-title{font-weight:600;font-size:32rpx;margin:20rpx 0 10rpx;word-break:break-all}.card-meta{font-size:25rpx;color:#64748b}.card-action{margin-top:20rpx}.skeleton{background:linear-gradient(100deg,#e7ecf3,#f2f5f9,#e7ecf3);border-radius:12rpx}.skeleton-line{height:28rpx;margin-top:20rpx;width:70%}.skeleton-short{width:40%}.footer{text-align:center;color:#64748b;padding:28rpx;font-size:26rpx}.body-text{white-space:pre-wrap;word-break:break-all;line-height:1.85}.spaced{margin-top:24rpx}.status-removed{background:#f1f2f4;color:#64748b}.loading{color:#2f5597;font-size:28rpx}.count{text-align:right;color:#64748b;font-size:25rpx}.full{width:100%}
